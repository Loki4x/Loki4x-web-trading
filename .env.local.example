NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Used to build the email-confirmation redirect link during signup.
# Set to http://localhost:3000 locally, and your production URL on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Review Jurnal AI (halaman Reports). Buat key di https://console.anthropic.com → API Keys.
# Tanpa key ini, tombol review AI menampilkan pesan "belum diaktifkan".
ANTHROPIC_API_KEY=your-anthropic-api-key
